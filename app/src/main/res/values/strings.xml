    <!-- Registration Rules -->
    <string name="rules_title">Before You Continue</string>

    <string name="rules_subtitle">
        Please review the following rules before creating your SaveFood account.
    </string>

    <string name="registration_rules">
        1. Provide accurate and valid information when creating your account.

        2. Your phone number will be used as the contact number for your organization.

        3. You must select the correct organization type during registration.

        4. Your organization location must be accurate to help other users find your organization.

        5. Do not provide false, misleading, or unauthorized information.

        6. Use your account only for legitimate food donation and charity activities.

        7. Keep your account credentials secure and do not share your password with others.

        8. By continuing, you confirm that you understand and agree to these rules.
    </string>

