<?xml version="1.0" encoding="utf-8"?>

<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/savefood_background"
    android:fillViewport="true"
    android:overScrollMode="never">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/screen_padding_large"
        android:paddingTop="@dimen/spacing_24"
        android:paddingEnd="@dimen/screen_padding_large"
        android:paddingBottom="@dimen/spacing_32">

        <!-- ==================================================== -->
        <!-- TITLE -->
        <!-- ==================================================== -->

        <TextView
            style="@style/SaveFood_Text_ScreenTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Add Food Offer" />

        <!-- ==================================================== -->
        <!-- FOOD NAME -->
        <!-- ==================================================== -->

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_24"
            android:hint="Food Name"
            app:boxCornerRadiusBottomEnd="@dimen/input_corner_radius"
            app:boxCornerRadiusBottomStart="@dimen/input_corner_radius"
            app:boxCornerRadiusTopEnd="@dimen/input_corner_radius"
            app:boxCornerRadiusTopStart="@dimen/input_corner_radius">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etFoodName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textCapSentences"
                android:maxLines="1" />

        </com.google.android.material.textfield.TextInputLayout>

        <!-- ==================================================== -->
        <!-- QUANTITY -->
        <!-- ==================================================== -->

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_12"
            android:hint="Quantity"
            app:boxCornerRadiusBottomEnd="@dimen/input_corner_radius"
            app:boxCornerRadiusBottomStart="@dimen/input_corner_radius"
            app:boxCornerRadiusTopEnd="@dimen/input_corner_radius"
            app:boxCornerRadiusTopStart="@dimen/input_corner_radius">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etQuantity"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="number"
                android:maxLines="1" />

        </com.google.android.material.textfield.TextInputLayout>

        <!-- ==================================================== -->
        <!-- DESCRIPTION -->
        <!-- ==================================================== -->

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_12"
            android:hint="Description"
            app:boxCornerRadiusBottomEnd="@dimen/input_corner_radius"
            app:boxCornerRadiusBottomStart="@dimen/input_corner_radius"
            app:boxCornerRadiusTopEnd="@dimen/input_corner_radius"
            app:boxCornerRadiusTopStart="@dimen/input_corner_radius">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etDescription"
                android:layout_width="match_parent"
                android:layout_height="120dp"
                android:gravity="top|start"
                android:inputType="textCapSentences|textMultiLine" />

        </com.google.android.material.textfield.TextInputLayout>

        <!-- ==================================================== -->
        <!-- EXPIRY DATE -->
        <!-- ==================================================== -->

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_12"
            android:hint="Expiry Date"
            app:boxCornerRadiusBottomEnd="@dimen/input_corner_radius"
            app:boxCornerRadiusBottomStart="@dimen/input_corner_radius"
            app:boxCornerRadiusTopEnd="@dimen/input_corner_radius"
            app:boxCornerRadiusTopStart="@dimen/input_corner_radius">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etExpiryDate"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clickable="true"
                android:focusable="false"
                android:inputType="none"
                android:maxLines="1" />

        </com.google.android.material.textfield.TextInputLayout>

        <!-- ==================================================== -->
        <!-- CAMERA -->
        <!-- ==================================================== -->

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnTakePhoto"
            android:layout_width="match_parent"
            android:layout_height="@dimen/button_height"
            android:layout_marginTop="@dimen/spacing_20"
            android:text="Take Photo"
            android:textSize="@dimen/text_body_small"
            android:textStyle="bold"
            app:cornerRadius="@dimen/button_corner_radius"
            style="@style/Widget.Material3.Button.OutlinedButton" />

        <!-- ==================================================== -->
        <!-- FOOD CONDITIONS -->
        <!-- ==================================================== -->

        <TextView
            style="@style/SaveFood_Text_Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_24"
            android:text="Food Conditions"
            android:textSize="@dimen/text_section_title"
            android:textStyle="bold" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_12"
            app:cardBackgroundColor="@color/savefood_surface"
            app:cardCornerRadius="@dimen/card_corner_radius"
            app:cardElevation="0dp"
            app:strokeColor="@color/savefood_border"
            app:strokeWidth="@dimen/card_stroke_width">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/spacing_8">

                <CheckBox
                    android:id="@+id/cbFresh"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:buttonTint="?attr/colorPrimary"
                    android:minHeight="48dp"
                    android:text="Food is fresh"
                    android:textColor="@color/savefood_text_primary"
                    android:textSize="@dimen/text_body_small" />

                <CheckBox
                    android:id="@+id/cbNoMold"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:buttonTint="?attr/colorPrimary"
                    android:minHeight="48dp"
                    android:text="No mold present"
                    android:textColor="@color/savefood_text_primary"
                    android:textSize="@dimen/text_body_small" />

                <CheckBox
                    android:id="@+id/cbNoBadSmell"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:buttonTint="?attr/colorPrimary"
                    android:minHeight="48dp"
                    android:text="No bad smell"
                    android:textColor="@color/savefood_text_primary"
                    android:textSize="@dimen/text_body_small" />

                <CheckBox
                    android:id="@+id/cbProperStorage"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:buttonTint="?attr/colorPrimary"
                    android:minHeight="48dp"
                    android:text="Properly stored"
                    android:textColor="@color/savefood_text_primary"
                    android:textSize="@dimen/text_body_small" />

                <CheckBox
                    android:id="@+id/cbPackagingIntact"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:buttonTint="?attr/colorPrimary"
                    android:minHeight="48dp"
                    android:text="Packaging is intact"
                    android:textColor="@color/savefood_text_primary"
                    android:textSize="@dimen/text_body_small" />

                <CheckBox
                    android:id="@+id/cbSafeToConsume"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:buttonTint="?attr/colorPrimary"
                    android:minHeight="48dp"
                    android:text="Safe to consume"
                    android:textColor="@color/savefood_text_primary"
                    android:textSize="@dimen/text_body_small" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- ==================================================== -->
        <!-- CREATE OFFER -->
        <!-- ==================================================== -->

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCreateOffer"
            android:layout_width="match_parent"
            android:layout_height="@dimen/button_height"
            android:layout_marginTop="@dimen/spacing_24"
            android:text="Create Offer"
            android:textSize="@dimen/text_body_small"
            android:textStyle="bold"
            app:cornerRadius="@dimen/button_corner_radius" />

        <!-- ==================================================== -->
        <!-- CANCEL -->
        <!-- ==================================================== -->

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCancel"
            android:layout_width="match_parent"
            android:layout_height="@dimen/button_height_small"
            android:layout_marginTop="@dimen/spacing_8"
            android:text="Cancel"
            android:textSize="@dimen/text_body_small"
            app:cornerRadius="@dimen/button_corner_radius"
            style="@style/Widget.Material3.Button.TextButton" />

    </LinearLayout>

</androidx.core.widget.NestedScrollView>