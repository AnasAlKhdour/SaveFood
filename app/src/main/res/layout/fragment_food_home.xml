<?xml version="1.0" encoding="utf-8"?>

<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/savefood_background"
    android:fillViewport="true"
    android:overScrollMode="never">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/screen_padding_large"
        android:paddingTop="@dimen/spacing_24"
        android:paddingEnd="@dimen/screen_padding_large"
        android:paddingBottom="@dimen/spacing_32">

        <!-- ==================================================== -->
        <!-- WELCOME -->
        <!-- ==================================================== -->

        <TextView
            android:id="@+id/tvWelcome"
            style="@style/SaveFood_Text_ScreenTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Welcome" />

        <!-- ==================================================== -->
        <!-- ROLE -->
        <!-- ==================================================== -->

        <TextView
            android:id="@+id/tvRole"
            style="@style/SaveFood_Text_Secondary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_8"
            android:text="Food Institution"
            android:textSize="@dimen/text_body_small" />

        <!-- ==================================================== -->
        <!-- INFORMATION CARD -->
        <!-- ==================================================== -->

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_24"
            app:cardBackgroundColor="@color/savefood_surface"
            app:cardCornerRadius="@dimen/card_corner_radius"
            app:cardElevation="@dimen/card_elevation"
            app:strokeColor="@color/savefood_border"
            app:strokeWidth="@dimen/card_stroke_width">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/card_padding_large">

                <TextView
                    style="@style/SaveFood_Text_Body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Manage your food donations"
                    android:textSize="@dimen/text_section_title"
                    android:textStyle="bold" />

                <TextView
                    style="@style/SaveFood_Text_Secondary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_8"
                    android:lineSpacingExtra="3dp"
                    android:text="Create food offers, manage your donations, and respond to charity requests." />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- ==================================================== -->
        <!-- NAVIGATION HINT -->
        <!-- ==================================================== -->

        <TextView
            style="@style/SaveFood_Text_Secondary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_24"
            android:text="Use the navigation below to manage your offers and requests." />

    </LinearLayout>

</androidx.core.widget.NestedScrollView>