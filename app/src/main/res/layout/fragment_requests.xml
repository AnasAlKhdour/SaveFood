<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/savefood_background">

    <!-- ==================================================== -->
    <!-- TITLE -->
    <!-- ==================================================== -->

    <TextView
        android:id="@+id/tvRequestsTitle"
        style="@style/SaveFood_Text_ScreenTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/screen_padding_large"
        android:layout_marginTop="@dimen/spacing_24"
        android:layout_marginEnd="@dimen/screen_padding_large"
        android:text="My Requests"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- ==================================================== -->
    <!-- SUBTITLE -->
    <!-- ==================================================== -->

    <TextView
        android:id="@+id/tvRequestsSubtitle"
        style="@style/SaveFood_Text_Secondary"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/screen_padding_large"
        android:layout_marginTop="@dimen/spacing_8"
        android:layout_marginEnd="@dimen/screen_padding_large"
        android:text="Track the food requests submitted by your organization."
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvRequestsTitle" />

    <!-- ==================================================== -->
    <!-- REQUESTS LIST -->
    <!-- ==================================================== -->

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerViewRequests"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:paddingStart="@dimen/spacing_16"
        android:paddingTop="@dimen/spacing_16"
        android:paddingEnd="@dimen/spacing_16"
        android:paddingBottom="@dimen/spacing_20"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvRequestsSubtitle" />

    <!-- ==================================================== -->
    <!-- EMPTY STATE -->
    <!-- ==================================================== -->

    <LinearLayout
        android:id="@+id/layoutEmptyRequests"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/spacing_32"
        android:layout_marginEnd="@dimen/spacing_32"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="@id/recyclerViewRequests"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/recyclerViewRequests">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="📋"
            android:textSize="48sp" />

        <TextView
            android:id="@+id/tvEmptyRequests"
            style="@style/SaveFood_Text_Secondary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_8"
            android:gravity="center"
            android:text="You haven't submitted any requests yet." />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>