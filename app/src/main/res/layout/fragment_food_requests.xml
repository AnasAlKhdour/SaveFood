<?xml version="1.0" encoding="utf-8"?>

<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/savefood_background"
    android:fillViewport="true"
    android:overScrollMode="never">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/screen_padding_large"
        android:paddingTop="@dimen/spacing_24"
        android:paddingEnd="@dimen/screen_padding_large"
        android:paddingBottom="@dimen/spacing_32">

        <!-- ==================================================== -->
        <!-- TITLE -->
        <!-- ==================================================== -->

        <TextView
            style="@style/SaveFood_Text_ScreenTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Incoming Requests" />

        <!-- ==================================================== -->
        <!-- EMPTY STATE -->
        <!-- ==================================================== -->

        <TextView
            android:id="@+id/tvNoRequests"
            style="@style/SaveFood_Text_Secondary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_24"
            android:gravity="center"
            android:text="No incoming requests"
            android:visibility="gone" />

        <!-- ==================================================== -->
        <!-- REQUESTS -->
        <!-- ==================================================== -->

        <LinearLayout
            android:id="@+id/requestsContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_20"
            android:orientation="vertical" />

    </LinearLayout>

</androidx.core.widget.NestedScrollView>