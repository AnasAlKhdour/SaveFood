<?xml version="1.0" encoding="utf-8"?>

<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/savefood_background"
    android:overScrollMode="never">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/screen_padding_large"
        android:paddingTop="@dimen/spacing_24"
        android:paddingEnd="@dimen/screen_padding_large"
        android:paddingBottom="@dimen/spacing_32">

        <!-- ==================================================== -->
        <!-- GREETING -->
        <!-- ==================================================== -->

        <TextView
            android:id="@+id/tvGreeting"
            style="@style/SaveFood_Text_Secondary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Welcome back 👋"
            android:textSize="@dimen/text_secondary" />

        <!-- ==================================================== -->
        <!-- ORGANIZATION NAME -->
        <!-- ==================================================== -->

        <TextView
            android:id="@+id/tvOrganizationName"
            style="@style/SaveFood_Text_ScreenTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_4"
            android:text="Charity Organization" />

        <!-- ==================================================== -->
        <!-- HERO CARD -->
        <!-- ==================================================== -->

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_24"
            app:cardBackgroundColor="@color/savefood_green"
            app:cardCornerRadius="@dimen/card_corner_radius"
            app:cardElevation="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/card_padding_large">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Help good food reach those who need it."
                    android:textColor="@color/white"
                    android:textSize="@dimen/text_section_title"
                    android:textStyle="bold" />

                <TextView
                    style="@style/SaveFood_Text_Secondary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_8"
                    android:lineSpacingExtra="3dp"
                    android:text="Explore nearby food donations and request what your organization needs."
                    android:textColor="@color/savefood_green_light" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- ==================================================== -->
        <!-- QUICK ACCESS -->
        <!-- ==================================================== -->

        <TextView
            style="@style/SaveFood_Text_Body"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_24"
            android:text="Quick Access"
            android:textSize="@dimen/text_section_title"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_12"
            android:orientation="horizontal">

            <!-- Browse Offers -->

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardBrowseOffers"
                android:layout_width="0dp"
                android:layout_height="150dp"
                android:layout_marginEnd="@dimen/spacing_8"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true"
                app:cardBackgroundColor="@color/savefood_surface"
                app:cardCornerRadius="@dimen/card_corner_radius"
                app:cardElevation="@dimen/card_elevation"
                app:strokeColor="@color/savefood_border"
                app:strokeWidth="@dimen/card_stroke_width">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="@dimen/spacing_16">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🍽"
                        android:textSize="34sp" />

                    <TextView
                        style="@style/SaveFood_Text_Body"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_8"
                        android:text="Browse Offers"
                        android:textSize="@dimen/text_body_small"
                        android:textStyle="bold" />

                    <TextView
                        style="@style/SaveFood_Text_Secondary"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_4"
                        android:text="Find available food"
                        android:textSize="@dimen/text_caption" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- My Requests -->

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardMyRequests"
                android:layout_width="0dp"
                android:layout_height="150dp"
                android:layout_marginStart="@dimen/spacing_8"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true"
                app:cardBackgroundColor="@color/savefood_surface"
                app:cardCornerRadius="@dimen/card_corner_radius"
                app:cardElevation="@dimen/card_elevation"
                app:strokeColor="@color/savefood_border"
                app:strokeWidth="@dimen/card_stroke_width">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="@dimen/spacing_16">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="📋"
                        android:textSize="34sp" />

                    <TextView
                        style="@style/SaveFood_Text_Body"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_8"
                        android:text="My Requests"
                        android:textSize="@dimen/text_body_small"
                        android:textStyle="bold" />

                    <TextView
                        style="@style/SaveFood_Text_Secondary"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_4"
                        android:text="Track your requests"
                        android:textSize="@dimen/text_caption" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>

        <!-- ==================================================== -->
        <!-- INFORMATION CARD -->
        <!-- ==================================================== -->

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_20"
            app:cardBackgroundColor="@color/savefood_green_light"
            app:cardCornerRadius="@dimen/card_corner_radius"
            app:cardElevation="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/card_padding_large">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🌱 Make an impact"
                    android:textColor="@color/savefood_green_dark"
                    android:textSize="@dimen/text_body_small"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_4"
                    android:lineSpacingExtra="2dp"
                    android:text="Every requested donation helps reduce food waste and supports people in need."
                    android:textColor="@color/savefood_green_dark"
                    android:textSize="@dimen/text_secondary" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>

</androidx.core.widget.NestedScrollView>