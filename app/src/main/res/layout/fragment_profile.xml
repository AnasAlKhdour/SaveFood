<?xml version="1.0" encoding="utf-8"?>

<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/savefood_background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/screen_padding_large"
        android:paddingTop="@dimen/spacing_24"
        android:paddingEnd="@dimen/screen_padding_large"
        android:paddingBottom="@dimen/spacing_24">

        <!-- ==================================================== -->
        <!-- PROFILE HEADER -->
        <!-- ==================================================== -->

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="@color/savefood_green"
            app:cardCornerRadius="@dimen/card_corner_radius_large"
            app:cardElevation="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="@dimen/card_padding_large">

                <TextView
                    android:layout_width="72dp"
                    android:layout_height="72dp"
                    android:background="@color/savefood_green_light"
                    android:gravity="center"
                    android:text="👤"
                    android:textSize="34sp" />

                <TextView
                    android:id="@+id/tvProfileName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_12"
                    android:gravity="center"
                    android:text="Charity Organization"
                    android:textColor="@color/white"
                    android:textSize="23sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvProfileRole"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_8"
                    android:text="Charity Organization"
                    android:textColor="@color/savefood_green_light"
                    android:textSize="@dimen/text_body_small" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- ==================================================== -->
        <!-- ACCOUNT INFORMATION -->
        <!-- ==================================================== -->

        <TextView
            style="@style/SaveFood_Text_SectionTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_24"
            android:text="Account Information" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_12"
            app:cardBackgroundColor="@color/savefood_surface"
            app:cardCornerRadius="@dimen/card_corner_radius"
            app:cardElevation="@dimen/card_elevation"
            app:strokeColor="@color/savefood_border"
            app:strokeWidth="@dimen/card_stroke_width">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/card_padding">

                <!-- Email -->

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Email"
                    android:textColor="@color/savefood_text_secondary"
                    android:textSize="@dimen/text_caption"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvProfileEmail"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_4"
                    android:text="email@example.com"
                    android:textColor="@color/savefood_text_primary"
                    android:textSize="@dimen/text_body_large" />

                <!-- Phone -->

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_16"
                    android:text="Phone"
                    android:textColor="@color/savefood_text_secondary"
                    android:textSize="@dimen/text_caption"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvProfilePhone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_4"
                    android:text="Phone not set"
                    android:textColor="@color/savefood_text_primary"
                    android:textSize="@dimen/text_body_large" />

                <!-- Divider -->

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="@dimen/spacing_16"
                    android:background="@color/savefood_divider" />

                <!-- Registered Location -->

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_16"
                    android:text="Registered Location"
                    android:textColor="@color/savefood_text_secondary"
                    android:textSize="@dimen/text_caption"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvProfileLocation"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_4"
                    android:text="Location not set"
                    android:textColor="@color/savefood_text_primary"
                    android:textSize="@dimen/text_body_large" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- ==================================================== -->
        <!-- ACCOUNT ACTIONS -->
        <!-- ==================================================== -->

        <TextView
            style="@style/SaveFood_Text_SectionTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_24"
            android:text="Account" />

        <!-- Edit Profile -->

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnEditProfile"
            android:layout_width="match_parent"
            android:layout_height="@dimen/button_height"
            android:layout_marginTop="@dimen/spacing_12"
            android:text="Edit Profile"
            android:textColor="@color/savefood_green"
            android:textSize="@dimen/text_button"
            android:textStyle="bold"
            app:backgroundTint="@color/savefood_surface"
            app:cornerRadius="@dimen/button_corner_radius"
            app:rippleColor="@color/savefood_green_light"
            app:strokeColor="@color/savefood_green"
            app:strokeWidth="@dimen/card_stroke_width" />

        <!-- Change Password -->

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnChangePassword"
            android:layout_width="match_parent"
            android:layout_height="@dimen/button_height"
            android:layout_marginTop="@dimen/spacing_12"
            android:text="Change Password"
            android:textColor="@color/savefood_green"
            android:textSize="@dimen/text_button"
            android:textStyle="bold"
            app:backgroundTint="@color/savefood_surface"
            app:cornerRadius="@dimen/button_corner_radius"
            app:rippleColor="@color/savefood_green_light"
            app:strokeColor="@color/savefood_green"
            app:strokeWidth="@dimen/card_stroke_width" />

        <!-- Change Location -->

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnChangeLocation"
            android:layout_width="match_parent"
            android:layout_height="@dimen/button_height"
            android:layout_marginTop="@dimen/spacing_12"
            android:text="Change Location"
            android:textColor="@color/savefood_green"
            android:textSize="@dimen/text_button"
            android:textStyle="bold"
            app:backgroundTint="@color/savefood_surface"
            app:cornerRadius="@dimen/button_corner_radius"
            app:rippleColor="@color/savefood_green_light"
            app:strokeColor="@color/savefood_green"
            app:strokeWidth="@dimen/card_stroke_width" />

        <!-- Logout -->

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnProfileLogout"
            android:layout_width="match_parent"
            android:layout_height="@dimen/button_height"
            android:layout_marginTop="@dimen/spacing_24"
            android:text="Logout"
            android:textColor="@color/savefood_green"
            android:textSize="@dimen/text_button"
            android:textStyle="bold"
            app:backgroundTint="@color/savefood_surface"
            app:cornerRadius="@dimen/button_corner_radius"
            app:rippleColor="@color/savefood_green_light"
            app:strokeColor="@color/savefood_green"
            app:strokeWidth="@dimen/card_stroke_width" />

        <!-- Delete Account -->

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnDeleteAccount"
            android:layout_width="match_parent"
            android:layout_height="@dimen/button_height"
            android:layout_marginTop="@dimen/spacing_8"
            android:layout_marginBottom="@dimen/spacing_8"
            android:text="Delete Account"
            android:textColor="@color/savefood_error"
            android:textSize="@dimen/text_button"
            android:textStyle="bold"
            app:backgroundTint="@color/savefood_surface"
            app:cornerRadius="@dimen/button_corner_radius"
            app:rippleColor="@color/savefood_error"
            app:strokeColor="@color/savefood_error"
            app:strokeWidth="@dimen/card_stroke_width" />

    </LinearLayout>

</androidx.core.widget.NestedScrollView>