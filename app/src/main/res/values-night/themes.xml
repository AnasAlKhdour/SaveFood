<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- ==================================================== -->
    <!-- DARK / NIGHT THEME -->
    <!-- ==================================================== -->

    <style
        name="Base.Theme.SaveFood"
        parent="Theme.Material3.DayNight.NoActionBar">

        <!-- Primary -->
        <item name="colorPrimary">
            @color/savefood_green
        </item>

        <item name="colorOnPrimary">
            @color/white
        </item>

        <item name="colorPrimaryContainer">
            @color/savefood_green_light
        </item>

        <item name="colorOnPrimaryContainer">
            @color/savefood_green_dark
        </item>

        <!-- Secondary -->
        <item name="colorSecondary">
            @color/savefood_green
        </item>

        <item name="colorOnSecondary">
            @color/white
        </item>

        <item name="colorSecondaryContainer">
            @color/savefood_green_light
        </item>

        <item name="colorOnSecondaryContainer">
            @color/savefood_green_dark
        </item>

        <!-- Tertiary -->
        <item name="colorTertiary">
            @color/savefood_green
        </item>

        <item name="colorOnTertiary">
            @color/white
        </item>

        <!-- Surface -->
        <item name="colorSurface">
            @color/savefood_surface
        </item>

        <item name="colorOnSurface">
            @color/savefood_text_primary
        </item>

        <item name="colorSurfaceVariant">
            @color/savefood_surface_alt
        </item>

        <item name="colorOnSurfaceVariant">
            @color/savefood_text_secondary
        </item>

        <!-- Outline -->
        <item name="colorOutline">
            @color/savefood_border
        </item>

        <item name="colorOutlineVariant">
            @color/savefood_divider
        </item>

        <!-- Window -->
        <item name="android:windowBackground">
            @color/savefood_background
        </item>

        <item name="android:statusBarColor">
            @color/savefood_green_dark
        </item>

        <item name="android:navigationBarColor">
            @color/savefood_surface
        </item>

        <item name="android:windowLightNavigationBar">
            true
        </item>

    </style>

</resources>